# Image published by .github/workflows/dokploy-image.yml
CUSTOM_IMAGE=ghcr.io/nyrexcoder/crm
CUSTOM_TAG=dokploy
PULL_POLICY=always

# Public hostname. Create the same DNS A record and Dokploy domain.
SITE_NAME=crm.example.com

# Replace both values with separate, strong random passwords.
DB_PASSWORD=replace-with-a-strong-random-database-password
ADMIN_PASSWORD=replace-with-a-strong-random-administrator-password

# Runtime defaults
MIGRATE_SITES=true
MUTE_EMAILS=0
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Dokploy/Traefik forwards the real client address in this header.
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
