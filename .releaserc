{
	"branches": ["main"],
	"plugins": [
		"@semantic-release/commit-analyzer", {
			"preset": "angular"
		},
		"@semantic-release/release-notes-generator",
		[
			"@semantic-release/exec", {
				"prepareCmd": 'sed -ir "s/[0-9]*\.[0-9]*\.[0-9]*/${nextRelease.version}/" crm/__init__.py && python3 .github/helpers/stamp_changelog.py ${nextRelease.version} $(date -u +%F)'
			}
		],
		[
			"@semantic-release/git", {
				"assets": ["crm/__init__.py", "frontend/src/changelog/*.md"],
				"message": "chore(release): Bumped to Version ${nextRelease.version}"
			}
		],
		"@semantic-release/github"
	]
}