    {
     "filters": [
      {
       "expression": {
        "expression": "expected_closure_date >= date_sub(today(), 12, 'month')",
        "type": "expression"
       }
      }
     ],
     "logical_operator": "And",
     "type": "filter_group"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "if_else(status_type == 'Lost', expected_deal_value * coalesce(exchange_rate, 1), expected_deal_value * coalesce(probability, 0) / 100 * coalesce(exchange_rate, 1))",
      "type": "expression"
     },
     "new_name": "forecasted",
     "type": "mutate"
    },
    {
     "data_type": "Decimal",
     "expression": {
      "expression": "if_else(status_type == 'Won', deal_value_base, 0)",
      "type": "expression"
     },
     "new_name": "actual",
     "type": "mutate"
    },
    {
     "column_names": [
